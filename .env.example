# ── Welliva API (the /server backend) ──
# URL of the backend that runs Gozlin AI + diet/workout generation on Claude Haiku.
# Leave UNSET to keep the app fully offline (on-device deterministic engines).
# Simulator/emulator: http://localhost:8787
# Physical device: use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=

# ── RevenueCat (subscriptions) ──
# The PUBLIC app-specific SDK key from RevenueCat → Project settings → API keys.
# Prefixed by platform: Android keys start `goog_`, iOS keys start `appl_`.
# Safe to expose, exactly like the Supabase anon key below — entitlements are
# validated by RevenueCat against Google/Apple, never by this client. The SECRET
# key (sk_…) must NEVER appear here; it belongs only on the backend.
# Leave UNSET to disable billing entirely — the app runs fully on the free tier.
# Setup runbook: docs/monetization/setup.md
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ── ExerciseDB (exercise demonstration GIFs) ──
# Licensed GIF library used ONLY by the fitness/exercise section. Leave UNSET
# to skip demo media entirely — the app renders identically without it.
# API URL is the RapidAPI ExerciseDB endpoint; the key is your RapidAPI key.
EXPO_PUBLIC_EXERCISEDB_API_URL=
EXPO_PUBLIC_EXERCISEDB_API_KEY=

# Supabase Configuration
# Copy this file to `.env` and fill these in from your Supabase project:
#   Project Settings → Data API (URL) and Project Settings → API Keys (anon key).
# The anon key is safe to expose — Row-Level Security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://aisapqelfijpmqbpibqo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFpc2FwcWVsZmlqcG1xYnBpYnFvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQzNjU2ODMsImV4cCI6MjA5OTk0MTY4M30.em8htUFOshpG3H-qp0yD62bXT01cZSH58WVmzD53gko


