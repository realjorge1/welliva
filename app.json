{
  "expo": {
    "name": "welliva",
    "slug": "welliva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/welliva1024.png",
    "scheme": "welliva",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.welliva.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.welliva.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF1E6",
        "foregroundImage": "./assets/images/welliva512.png",
        "backgroundImage": "./assets/images/welliva512.png",
        "monochromeImage": "./assets/images/welliva512.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/welliva48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F8F7",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Welliva reads your upcoming events so your coach can plan around what's ahead — travel, exams, big days. Nothing leaves your device."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Welliva uses your location only to fetch local weather, so your coach can suggest indoor or outdoor workouts."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/welliva512.png",
          "color": "#E67E22"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Welliva accesses your photos so you can set a profile picture and add progress photos. They upload only to your private account storage."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
