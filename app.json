{
  "expo": {
    "name": "welliva",
    "slug": "welliva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-wordmark.png",
    "scheme": "welliva",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.welliva.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.welliva.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon-wordmark-foreground.png",
        "monochromeImage": "./assets/images/icon-wordmark-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-wordmark-96.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "welliva uses Face ID to unlock your cycle log."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "welliva reads your upcoming events so your coach can plan around what's ahead — travel, exams, big days. Nothing leaves your device."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "welliva uses your location only to fetch local weather, so your coach can suggest indoor or outdoor workouts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#EDB623"
        }
      ],
      [
        "./plugins/withNotificationLargeIcon",
        {
          "icon": "./assets/images/notification-large-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "welliva accesses your photos so you can log a meal from a picture, set a profile picture and add progress photos. A meal photo is read once to identify the foods and is never stored; the rest upload only to your private account storage.",
          "cameraPermission": "welliva uses your camera so you can log a meal by photographing it, and to scan a packaged food's barcode. The picture is read once and is never stored or uploaded."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "welliva uses your camera to scan a packaged food's barcode and to log a meal by photographing it. Nothing is recorded or uploaded — the frame is read on your device and discarded.",
          "microphonePermission": false,
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Pacifico-Regular.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "welliva",
              "description": "Today in one word, and your day as a line of light",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget/today-preview.png",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b78b05a-f5d4-483a-b448-27bb4eea931f"
      }
    }
  }
}
